{
  "name": "reviewroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.11.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @reviewroom/web build",
    "start": "pnpm --filter @reviewroom/server start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "typescript": "7.0.2"
  }
}
