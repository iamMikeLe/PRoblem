{
  "name": "@problem/desktop",
  "productName": "PRoblem",
  "version": "0.1.0",
  "description": "Run many Claude Code reviews side by side",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder --config electron-builder.yml",
    "release:mac": "node scripts/release-mac.mjs",
    "package:dir": "electron-vite build && electron-builder --config electron-builder.yml --dir",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "demo:gif": "electron-vite build && PROBLEM_FRAMES=test-results/frames playwright test demo && ffmpeg -loglevel error -y -f concat -i test-results/frames/frames.txt -vf \"fps=12,scale=960:-1:flags=lanczos,split[a][b];[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=4\" ../../docs/demo.gif",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.326",
    "@fluentui/react-components": "9.75.2",
    "@fluentui/react-icons": "2.0.346",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.65.1",
    "@problem/shared": "workspace:*",
    "@tanstack/react-query": "5.108.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "highlight.js": "11.11.1",
    "jsdom": "29.1.1",
    "lowlight": "3.3.0",
    "material-icon-theme": "5.40.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  }
}
